  generated = ktjvm.library(
    srcs = withBasePath("generated/kotlin") {
      file.glob("**.kt")
    },
    resourceDirs = ["generated/resources"],
    deps = [
      milestone2.parser,
      mgroup2.parser,
      ktlib.main,
      examples.metalang3,
      examples.astProto.javalib,
    ],
  )
}

gsonDep = maven.javaLib("com.google.code.gson", "gson", "2.13.1")

