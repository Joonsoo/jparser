mgroup2(basePath="mgroup2") {
  proto(basePath="data/proto") {
    schema = protobuf.schema(
      srcs = [
        "MilestoneGroupParserData.proto",
      ],
      deps = [milestone2.proto.schema],
    )

    javacode = protobuf.java(schema=mgroup2.proto.schema)
    javalib = java.library(
      srcs = mgroup2.proto.javacode.javaFiles,
      deps = [milestone2.proto.javalib],
    )
  }

  data = scala2.library(
    srcs = withBasePath("data/scala") {
      file.glob("**.scala")
    },
    deps = [milestone2.data, proto.javalib],
  )

  gen = scala2.library(
    srcs = withBasePath("gen/scala") {
      file.glob("**.scala")
    },
    deps = [milestone2.gen, data],
  )

  parser = scala2.library(
    srcs = withBasePath("parser/scala") {
      file.glob("**.scala")
    },
    deps = [milestone2.parser, base.main, data, parseutils.main],
  )

  test = scala2.library(
    srcs = withBasePath("test/scala") {
      file.glob("**.scala")
    },
    resourceDirs = ["test/resources"],
    deps = [
      ...scalaTestDeps,
      data,
      gen,
      parser,
      naive.main,
      examples.metalang3,
      milestone2.gen,
      milestone2.parser,
      milestone2.test,
    ],
  )

  genCli = ktjvm.library(
    srcs = withBasePath("genCli/kotlin") {
      file.glob("**.kt")
    },
    deps = [gen, metalang.main],
  )

  genCliJar = jar.executableUberJar(
    deps = [genCli],
    mainClass = "com.giyeok.jparser.mgroup2.GenCliKt",
  )

  class KotlinParser {
    srcsRoot: artifact
    astifier: artifact
    parserData: artifact
  }

  def genKtParser(
    cdgFile: path,
    astifierClassName: string,
    parserDataFileName: string = "mgroup2-parserdata.pb",
    trimParserData: bool = true,
  ): KotlinParser {
    let outDir = context.destDirectory()
    let srcsRoot = outDir / "srcs"
    let parserData = outDir / "data" / parserDataFileName
    // astifierClassName 의 마지막 컴포넌트 = 클래스명, 그 앞 = 패키지명.
    // 패키지 경로 / 클래스명.kt 는 CLI 가 srcs 안에 만들지만, KotlinParser 의 astifier 필드는
    // 그 정확한 파일 경로를 가리켜야 한다. 여기선 외부에서 알 수 없으므로 srcsRoot 자체로 둔다.
    // (소비측은 srcsRoot 디렉토리 전체를 컴파일하면 된다)
    let srcsArtifact = artifact.build(srcsRoot) {
      file.createDirectory(srcsRoot)
      file.createDirectory(outDir / "data")
      let genJar = genCliJar.jarFile.await()
      let baseCmd: list<string> = [
        "java",
        "-jar", genJar.absolutePath,
        cdgFile.absolutePath,
        "-astifierClass", astifierClassName,
        "-parserdata", parserData.absolutePath,
        "-srcs", srcsRoot.absolutePath,
      ]
      let cmd: list<string> = if trimParserData then baseCmd + ["-trim"] else baseCmd
      let result = context.runCommand(cmd)
      if result.exitCode != 0 {
        throw "mgroup2.genKtParser ${context.thisTargetName} (exit=${result.exitCode}): ${result.stderr}"
      }
      srcsRoot
    }
    let parserDataArtifact = artifact.build(parserData) {
      let _ = srcsArtifact.await()
      parserData
    }
    return KotlinParser(
      srcsRoot = srcsArtifact,
      astifier = srcsArtifact,
      parserData = parserDataArtifact,
    )
  }
}

mgroup3(basePath="mgroup3") {
  proto(basePath="schema/proto") {
    schema = protobuf.schema(
      srcs = [
        "Mgroup3ParserData.proto",
        "Mgroup3ParserResult.proto",
      ],
      deps = [base.proto.schema],
    )

    javacode = protobuf.java(schema=mgroup3.proto.schema)
    javalib = java.library(
      srcs = mgroup3.proto.javacode.javaFiles,
      deps = [base.proto.javalib],
    )
  }

  gen = ktjvm.library(
    srcs = withBasePath("gen/kotlin") {
      file.glob("**.kt")
    },
    deps = [
      proto.javalib,
      base.main,
      parseutils.main,
      maven.javaLib("com.google.guava", "guava", "33.4.8-jre"),
    ],
  )

  parser = ktjvm.library(
    srcs = withBasePath("parser/kotlin") {
      file.glob("**.kt")
    },
    deps = [
      proto.javalib,
      ktlib.main,
    ],
  )

  nativeParser = ktjvm.library(
    srcs = withBasePath("nativeParser/kotlin") {
      file.glob("**.kt")
    },
    deps = [
      proto.javalib,
      parser,
      ktlib.main,
      base.proto.javalib,
    ],
  )

  test = ktjvm.library(
    srcs = withBasePath("test/kotlin") {
      file.glob("**.kt")
    },
    resourceDirs = ["test/resources"],
    deps = [
      mgroup3.gen,
      mgroup3.parser,
      mgroup3.nativeParser,
      metalang.main,
      mgroup2.gen,
      mgroup2.parser,
      naive.main,
      milestone2.gen,
      milestone2.parser,
      ktparser.main,
      kttestutils.main,
      examples.generated,
      mgroup3.genCli,
    ] + testDeps,
  )

  genCli = ktjvm.library(
    srcs = withBasePath("genCli/kotlin") {
      file.glob("**.kt")
    },
    deps = [gen, metalang.main],
  )

  genCliJar = jar.executableUberJar(
    deps = [genCli],
    mainClass = "com.giyeok.jparser.mgroup3.GenCliKt",
  )

  class RustParser {
    // mgroup3 parser data 파일 경로
    parserData: artifact
    // AST data type 들을 serialize할 수 있는 protobuf 정의
    protoSchema: artifact
    // rustSrcsRoot 밑에는 mgroup3-native 에 dependency를 갖는,
    // rust parser crate가 생성되며, srcs, Cargo.toml, bulid.rs 가 있어야 함.
    // rust crate 에는 AST data class들이 포함되어 있고,
    // AST data class 들은 protobuf로 serialize할 수 있다.
    // 생성되는 rust crate는 input string을 받아 파싱을 수행하고,
    // 성공시엔 AST data type을, 실패시엔 에러 내용을 반환하는 기능을 포함한다.
    rustSrcsRoot: artifact
    // kotlinAdtRoot 에는 AST data type 구조를 정의한 코드가 포함되고,
    // protoSchema 에 정의된 protobuf Message 로부터 각 AST data type으로 변환하는 코드가 포함된다.
    kotlinAdtRoot: artifact
  }

  def genRustParser(
    cdgFile: path,
    // 생성될 Kotlin AST 클래스의 FQCN — 마지막 컴포넌트가 클래스명, 앞이 패키지.
    // proto 패키지는 "<패키지>.ast", 바인딩 클래스는 "<클래스명>ProtoBinding".
    astifierClassName: string = "com.giyeok.jparser.mgroup3.generated.Ast",
    // Rust crate 이름 — 여러 문법의 crate/dylib 공존을 위해 문법별로 지정.
    crateName: string = "mgroup3-generated-parser",
    // ".gz" 로 끝나면 gzip 으로 기록.
    parserDataFileName: string = "mgroup3-parserdata.pb.gz",
    astProtoFileName: string = "ast.proto",
    // grammar(NGrammar) 필드 제거 — 런타임(Kotlin/Rust)이 읽지 않는 디버그 정보.
    trimParserData: bool = true,
  ): RustParser {
    let outDir = context.destDirectory()
    let dataFile = outDir / "data" / parserDataFileName
    let protoFile = outDir / "proto" / astProtoFileName
    let rust = outDir / "rust"
    let kotlin = outDir / "kotlin"
    // 생성 crate 의 mgroup3-native path dependency 위치. context.definitionDir() 는
    // 호출자의 basePath 와 무관하게 **이 build.bbx4 가 있는 디렉토리** (jparser 리포
    // 루트) 기준이므로, 외부 프로젝트가 호출해도 항상 이 리포의 crate 를 가리킨다.
    // (bibix4 >= caa1b908 필요. 반드시 body 안에서 호출 — param default 에서 부르면
    // caller 파일이 잡힌다.)
    let nativeRoot = context.definitionDir() / "mgroup3-native"

    let rustArtifact = artifact.build(rust) {
      file.createDirectory(outDir / "data")
      file.createDirectory(outDir / "proto")
      file.createDirectory(rust)
      file.createDirectory(kotlin)
      let genJar = genCliJar.jarFile.await()
      let baseCmd: list<string> = [
        "java",
        "-jar", genJar.absolutePath,
        cdgFile.absolutePath,
        "-parserdata", dataFile.absolutePath,
        "-proto", protoFile.absolutePath,
        "-rust", rust.absolutePath,
        "-kotlin", kotlin.absolutePath,
        "-mgroup3-native", nativeRoot.absolutePath,
        "-astifierClass", astifierClassName,
        "-crateName", crateName,
      ]
      let cmd: list<string> = if trimParserData then baseCmd + ["-trimGrammar"] else baseCmd
      let result = context.runCommand(cmd)
      if result.exitCode != 0 {
        throw "mgroup3.genRustParser ${context.thisTargetName} (exit=${result.exitCode}): ${result.stderr}"
      }
      rust
    }
    let parserDataArtifact = artifact.build(dataFile) {
      let _ = rustArtifact.await()
      dataFile
    }
    let protoSchemaArtifact = artifact.build(protoFile) {
      let _ = rustArtifact.await()
      protoFile
    }
    let kotlinArtifact = artifact.build(kotlin) {
      let _ = rustArtifact.await()
      kotlin
    }
    return RustParser(
      parserData = parserDataArtifact,
      protoSchema = protoSchemaArtifact,
      rustSrcsRoot = rustArtifact,
      kotlinAdtRoot = kotlinArtifact
    )
  }

  // 현재 플랫폼의 dylib 파일명 (lib<crate>_underscored.{dylib|so} / <crate>.dll).
  def dylibFileNameOf(crateName: string): string {
    let libName = crateName.replace("-", "_")
    let os = context.os
    if os.contains("mac") || os.contains("darwin") {
      return "lib${libName}.dylib"
    }
    if os.contains("windows") {
      return "${libName}.dll"
    }
    return "lib${libName}.so"
  }

  // 리소스 디렉토리 규약: native/<os>-<arch>/ (예: native/darwin-aarch64/).
  // 런타임 로더 (생성 crate 의 Kotlin 바인딩 사용측) 와 일치해야 한다.
  def nativeResourceDirName(): string {
    let os = context.os
    let osPart = if os.contains("mac") || os.contains("darwin") then "darwin"
      else if os.contains("windows") then "windows"
      else "linux"
    return "${osPart}-${context.arch}"
  }

  // genRustParser 가 만든 crate 를 cargo 로 빌드해 cdylib 파일을 반환.
  // cargo 가 PATH 에 있어야 한다 (rustup 표준 설치 기준).
  def cargoDylib(
    crateRoot: artifact,
    crateName: string = "mgroup3-generated-parser",
    release: bool = true,
  ): artifact {
    let outDir = context.destDirectory()
    let targetDir = outDir / "target"
    let profile = if release then "release" else "debug"
    let dylib = targetDir / profile / dylibFileNameOf(crateName)
    return artifact.build(dylib) {
      let crate = crateRoot.await()
      let baseCmd: list<string> = [
        "cargo", "build",
        "--features", "ffi",
        "--manifest-path", (crate / "Cargo.toml").absolutePath,
        "--target-dir", targetDir.absolutePath,
      ]
      let cmd: list<string> = if release then baseCmd + ["--release"] else baseCmd
      let result = context.runCommand(cmd)
      if result.exitCode != 0 {
        throw "mgroup3.cargoDylib ${context.thisTargetName} (exit=${result.exitCode}): ${result.stderr}"
      }
      dylib
    }
  }
}

// mgroup4 — bounded interior milestone groups 프로토타입 (Phase A A0+A1).
// mgroup3 은 다른 프로젝트가 참조하는 안정 모듈이라 무변경 — mgroup4 는 별도 모듈.
// 최소 포크: parser 런타임(ParsingCtx/AcceptCondition/RecordConditionEvaluator/
// ParserDataPlain/Mgroup4Parser)만 mgroup4 패키지로 포크하고, proto(Mgroup3ParserData)
// 는 mgroup3.proto 의존으로 재사용 (parserdata 포맷 동일 — generator 는 mgroup3 것 재사용).
// 설계·계측 문서: mgroup3/docs/mgroup4_*.md. 게이트: runMgroup4DiffTest.
mgroup4(basePath="mgroup4") {
  parser = ktjvm.library(
    srcs = withBasePath("parser/kotlin") {
      file.glob("**.kt")
    },
    deps = [
      // proto 는 mgroup3 것 재사용 (parserdata 포맷 동일).
      mgroup3.proto.javalib,
      ktlib.main,
    ],
  )

  test = ktjvm.library(
    srcs = withBasePath("test/kotlin") {
      file.glob("**.kt")
    },
    deps = [
      mgroup4.parser,
      // G1 차등 오라클용 mgroup3 파서 (Mgroup4Parser(n=1) ≡ Mgroup3Parser 비교).
      mgroup3.parser,
      // 문법 인프로세스 생성 (Mgroup3ParserGenerator) + parserdata proto.
      mgroup3.gen,
      mgroup3.proto.javalib,
      metalang.main,
    ] + testDeps,
  )
}

ktlib(basePath="ktlib") {
  main = ktjvm.library(
    srcs = withBasePath("main/kotlin") {
      file.glob("**.kt")
    },
    deps = [mgroup2.proto.javalib],
  )
}

