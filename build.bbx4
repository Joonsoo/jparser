    mgroup4.test,
    .some("com.giyeok.jparser.mgroup4.Mgroup4DifferentialTest"),
    {"MG4_DIFF": "1", "MG4_SHAPE_STATS": "1", "MG4_LAZY_CACHE": "0"},
  )
}

