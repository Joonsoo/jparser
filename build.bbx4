namespace jparser

import protobuf
import ktjvm
import java
import jvm
import maven
import utils
import scala2
import jar

protobufVersion = "4.31.1"
scalaVersion = "2.13"
truthVersion = "1.4.2"

protobufJavaLib = maven.javaLib("com.google.protobuf", "protobuf-java", protobufVersion)
junitConsoleDep = maven.javaLib("org.junit.platform", "junit-platform-console-standalone", "1.8.2")

testDeps = [
  protobufJavaLib,
  maven.javaLib("org.junit.jupiter", "junit-jupiter-api", "5.8.2"),
  junitConsoleDep,
  maven.javaLib("com.google.truth", "truth", truthVersion),
  maven.javaLib("com.google.truth.extensions", "truth-proto-extension", truthVersion),
]

scalaTestDeps = [
  ...testDeps,
  maven.javaLib("org.scalatest", "scalatest_${scalaVersion}", "3.2.15"),
]

base(basePath="base") {
  proto(basePath="proto") {
    schema = protobuf.schema(
      srcs = [
        "GrammarProto.proto",
        "TermGroupProto.proto",
      ]
    )

    javacode = protobuf.java(schema=base.proto.schema)
    javalib = java.library(
      srcs = javacode.javaFiles,
      deps = [
        protobufJavaLib,
      ],
    )
  }

  main = scala2.library(
    srcs = withBasePath("main/scala") {
      file.glob("**.scala")
    },
    deps = [proto.javalib],
  )

  test = scala2.library(
    srcs = withBasePath("test/scala") {
      file.glob("**.scala")
    },
    deps = [...scalaTestDeps, base.main],
  )
}

